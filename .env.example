# ---------------------------------------------------------------------------
# KOHLER AI BathPlan — backend configuration
# Copy to .env and fill in. The app starts and the full deterministic planner
# works with NO keys set; only the AI layers degrade to fallbacks.
# ---------------------------------------------------------------------------

# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Catalog location (relative to repository root)
CATALOG_PATH=catalog/products.json

# --- AI layers (both optional) ---------------------------------------------
# One Google Gemini key powers both the vision module and the agent layer.
GEMINI_API_KEY=

# Vision: image -> structured, non-authoritative spatial evidence.
# Set VISION_ENABLED=false to force the manual-input fallback path.
VISION_ENABLED=true
GEMINI_VISION_MODEL=gemini-2.5-flash

# Agent: natural-language intent + explanation. Never computes feasibility.
# Set LLM_ENABLED=false to force deterministic templated explanations.
LLM_ENABLED=true
GEMINI_LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
